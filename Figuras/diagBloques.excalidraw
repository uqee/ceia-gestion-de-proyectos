      "seed": 1876997922,
      "version": 161,
      "versionNonce": 836465279,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782951527073,
      "link": null,
      "locked": false,
      "text": "Facebook Chess Games\n- async games (chess)\n- if it's not your turn, you can undo your move",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Facebook Chess Games\n- async games (chess)\n- if it's not your turn, you can undo your move",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q7jfHzVc2G1U99sTOaWUi",
      "type": "text",
      "x": 989.1015381262243,
      "y": 996.0025797348521,
      "width": 1112.316650390625,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1l",
      "roundness": null,
      "seed": 1573809506,
      "version": 347,
      "versionNonce": 27932913,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782951527073,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- users can start a game of chess with a friend\n- users a send a chess move\n- users can undo their move if the other player didn't move yet\n\n---\nOut of Scope\n- time limit on move per user\n- rematch with friend after game is done\n- complete history of chess moves",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- users can start a game of chess with a friend\n- users a send a chess move\n- users can undo their move if the other player didn't move yet\n\n---\nOut of Scope\n- time limit on move per user\n- rematch with friend after game is done\n- complete history of chess moves",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CTUvQaq7FnMwNsQEud4wb",
      "type": "text",
      "x": 1040.631897789731,
      "y": 826.1691983138876,
      "width": 516.1500244140625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
