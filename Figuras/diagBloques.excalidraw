    {
      "id": "n0vcJ4DQnV2JZ-7GWc59h",
      "type": "text",
      "x": 1445.5132951458554,
      "y": 1838.3726917041986,
      "width": 670.3499755859375,
      "height": 1215,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1p",
      "roundness": null,
      "seed": 1854235554,
      "version": 285,
      "versionNonce": 1773367473,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782951527073,
      "link": null,
      "locked": false,
      "text": "APIs\n\nPOST /chess/game -> ChessGame\n{\n    player1,\n    player2\n}\n\nPOST /chess/game/move -> Move\n{\n    gameId,\n    playerId,\n    chessPiece,\n    moveAction\n}\n\nPATCH /chess/game/undo -> Move\n{\n    gameId,\n    playerId,\n    moveId\n}\n\nPOST /chess/game/live -> ChessGame\n{\n    gameId\n}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs\n\nPOST /chess/game -> ChessGame\n{\n    player1,\n    player2\n}\n\nPOST /chess/game/move -> Move\n{\n    gameId,\n    playerId,\n    chessPiece,\n    moveAction\n}\n\nPATCH /chess/game/undo -> Move\n{\n    gameId,\n    playerId,\n    moveId\n}\n\nPOST /chess/game/live -> ChessGame\n{\n    gameId\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
