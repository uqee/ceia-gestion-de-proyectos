      "isDeleted": true,
      "boundElements": [],
      "updated": 1782951527073,
      "link": null,
      "locked": false,
      "text": "10% of Facebook plays chess\n200M DAU",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "10% of Facebook plays chess\n200M DAU",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "w_U8Dvp6tJD30lR8t6DqK",
      "type": "text",
      "x": 987.9408476517895,
      "y": 1508.7861268683898,
      "width": 1918.63330078125,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1n",
      "roundness": null,
      "seed": 529049122,
      "version": 348,
      "versionNonce": 2125984465,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782951527073,
      "link": null,
      "locked": false,
      "text": "Nonfunctional requirements\n- eventual consistency (high availability) for moves, but moves need to be made given the correct game state\n- low latency for starting game and sending moves (<2 sec)\n- ensure the order of moves is maintained\n- durability (can't lose track of moves)\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nonfunctional requirements\n- eventual consistency (high availability) for moves, but moves need to be made given the correct game state\n- low latency for starting game and sending moves (<2 sec)\n- ensure the order of moves is maintained\n- durability (can't lose track of moves)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
